# Cyent configuration template — copy to .env and fill in real values.
# Never commit the real .env file.

# OpenAI-compatible endpoint (gateway / DeepSeek / vLLM / OpenAI itself)
OPENAI_BASE_URL=https://api.openai.com/v1

# API key (keep secret!)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Model name
OPENAI_MODEL=gpt-4o-mini

# Optional tuning
CYENT_LOG_LEVEL=INFO
CYENT_LOG_DIR=logs
